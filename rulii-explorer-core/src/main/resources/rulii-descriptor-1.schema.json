{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.rulii.org/explorer/rulii-descriptor-1.schema.json",
  "title": "rulii explorer descriptor",
  "description": "Everything a rulii application holds: artifacts, references, bindings and problems, and (1.1) the beans it validates with rulii-bean-validation. Version 1.x is additive: readers must ignore properties they do not know.",
  "type": "object",
  "required": ["descriptorVersion", "application", "packages", "artifacts", "references", "bindings", "problems"],
  "properties": {
    "descriptorVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "application": { "$ref": "#/$defs/application" },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/bindingUsage" } },
    "problems": { "type": "array", "items": { "$ref": "#/$defs/problem" } },
    "beans": { "type": "array", "items": { "$ref": "#/$defs/bean" }, "description": "1.1. Absent when beans were not described; empty when they were and none was found." }
  },
  "$defs": {
    "application": {
      "type": "object",
      "required": ["ruliiVersion", "explorerVersion"],
      "properties": {
        "name": { "type": "string" },
        "ruliiVersion": { "type": "string" },
        "explorerVersion": { "type": "string" },
        "placeholderValues": { "type": "boolean" }
      }
    },
    "package": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["java", "xml"] }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "name", "type", "kind", "registered", "parameters"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["rule", "ruleset", "ruleflow"] },
        "kind": { "enum": ["xml-script", "xml", "rule-class", "java-builder", "predefined-validator", "unknown"] },
        "registered": { "type": "boolean" },
        "packageId": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "description": "Business category, '/' between the levels; absent when none." },
        "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "In declaration order, each once; absent when none." },
        "source": { "$ref": "#/$defs/source" },
        "className": { "type": "string" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "rule": { "$ref": "#/$defs/ruleDetails" },
        "validation": { "$ref": "#/$defs/validationDetails" },
        "ruleSet": { "$ref": "#/$defs/ruleSetDetails" },
        "ruleFlow": { "$ref": "#/$defs/ruleFlowDetails" }
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["xml", "java"] },
        "resource": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "className": { "type": "string" },
        "methodName": { "type": "string" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "defaultValue": { "type": "string" },
        "matchStrategy": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "expression": {
      "type": "object",
      "required": ["kind", "reads", "writes"],
      "properties": {
        "kind": { "enum": ["script", "compiled", "composite"] },
        "language": { "type": "string" },
        "text": { "type": "string" },
        "placeholders": { "type": "array", "items": { "$ref": "#/$defs/placeholder" } },
        "plain": { "$ref": "#/$defs/analysis" },
        "reads": { "type": "array", "items": { "type": "string" } },
        "writes": { "type": "array", "items": { "type": "string" } },
        "signature": { "type": "string" },
        "operator": { "type": "string" },
        "operands": { "type": "array", "items": { "$ref": "#/$defs/expression" } }
      }
    },
    "placeholder": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "defaultValue": { "type": "string" },
        "value": { "type": "string" },
        "hidden": { "type": "boolean" }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["complete", "tokens"],
      "properties": {
        "complete": { "type": "boolean" },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } }
      }
    },
    "token": {
      "type": "object",
      "required": ["t", "text"],
      "properties": {
        "t": { "enum": ["binding", "op", "literal", "placeholder", "call", "keyword", "raw"] },
        "text": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" } },
        "key": { "type": "string" },
        "defaultValue": { "type": "string" }
      }
    },
    "ruleDetails": {
      "type": "object",
      "required": ["then"],
      "properties": {
        "preCondition": { "$ref": "#/$defs/expression" },
        "given": { "$ref": "#/$defs/expression" },
        "then": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
        "otherwise": { "$ref": "#/$defs/expression" }
      }
    },
    "validationDetails": {
      "type": "object",
      "required": ["errorCode", "settings"],
      "properties": {
        "validator": { "type": "string" },
        "errorCode": { "type": "string" },
        "severity": { "enum": ["FATAL", "ERROR", "WARNING", "INFO"] },
        "errorMessage": { "type": "string" },
        "defaultMessage": { "type": "string" },
        "valueSource": { "$ref": "#/$defs/valueSource" },
        "failOnNull": { "type": "boolean" },
        "settings": { "type": "object" }
      }
    },
    "valueSource": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["binding", "expression"] },
        "name": { "type": "string" },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "ruleSetDetails": {
      "type": "object",
      "required": ["validating", "members"],
      "properties": {
        "validating": { "type": "boolean" },
        "preCondition": { "$ref": "#/$defs/expression" },
        "initializer": { "$ref": "#/$defs/expression" },
        "stopCondition": { "$ref": "#/$defs/expression" },
        "finalizer": { "$ref": "#/$defs/expression" },
        "resultExtractor": { "$ref": "#/$defs/expression" },
        "errorHandler": { "$ref": "#/$defs/expression" },
        "resultType": { "type": "string" },
        "resultTypeOrigin": { "enum": ["declared", "derived", "default", "unknown", "none"] },
        "members": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ruleFlowDetails": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "context": { "type": "string" },
        "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "globalHandler": { "$ref": "#/$defs/handler" },
        "finalizer": { "$ref": "#/$defs/expression" },
        "returning": { "$ref": "#/$defs/expression" },
        "resultType": { "type": "string" },
        "resultTypeOrigin": { "enum": ["declared", "derived", "default", "unknown", "none"] }
      }
    },
    "command": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["bind", "run", "apply", "execute", "async-run", "await", "when", "for-each", "scope", "exit", "custom"] },
        "target": { "$ref": "#/$defs/target" },
        "as": { "type": "string" },
        "scope": { "type": "string" },
        "params": { "$ref": "#/$defs/bindInfo" },
        "bind": { "$ref": "#/$defs/bindInfo" },
        "expression": { "$ref": "#/$defs/expression" },
        "condition": { "$ref": "#/$defs/expression" },
        "source": { "$ref": "#/$defs/expression" },
        "stop": { "$ref": "#/$defs/expression" },
        "item": { "type": "string" },
        "name": { "type": "string" },
        "mode": { "enum": ["shared", "immutable"] },
        "awaitKind": { "enum": ["one", "all", "any"] },
        "names": { "type": "array", "items": { "type": "string" } },
        "timeout": { "type": "string" },
        "thenRun": { "$ref": "#/$defs/continuation" },
        "handler": { "$ref": "#/$defs/handler" },
        "then": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "otherwise": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "body": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "className": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "required": ["kind", "resolution"],
      "properties": {
        "kind": { "enum": ["instance", "by-name", "by-class"] },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "resolution": { "enum": ["direct", "by-name", "by-class", "unresolved"] }
      }
    },
    "bindInfo": {
      "type": "object",
      "required": ["kind", "names"],
      "properties": {
        "scope": { "type": "string" },
        "kind": { "enum": ["literal", "declarations", "bindings", "map", "bean", "loader", "expression"] },
        "names": { "type": "array", "items": { "$ref": "#/$defs/boundName" } },
        "label": { "type": "string" }
      }
    },
    "boundName": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "expression": { "$ref": "#/$defs/expression" }
      }
    },
    "handler": {
      "type": "object",
      "required": ["exceptionType", "body"],
      "properties": {
        "exceptionType": { "type": "string" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "continuation": {
      "type": "object",
      "required": ["as", "body"],
      "properties": {
        "as": { "type": "string" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/command" } }
      }
    },
    "reference": {
      "type": "object",
      "required": ["from", "to", "type", "async", "path", "resolution"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "type": { "enum": ["contains", "runs", "cascades"] },
        "async": { "type": "boolean" },
        "path": { "type": "string" },
        "resolution": { "enum": ["direct", "by-name", "by-class"] }
      }
    },
    "bindingUsage": {
      "type": "object",
      "required": ["name", "readBy", "writtenBy", "unknownWriters"],
      "properties": {
        "name": { "type": "string" },
        "readBy": { "type": "array", "items": { "type": "string" } },
        "writtenBy": { "type": "array", "items": { "type": "string" } },
        "unknownWriters": { "type": "array", "items": { "type": "string" } }
      }
    },
    "problem": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string" },
        "artifact": { "type": "string", "description": "An artifact id, or (1.1) a bean id for a bean problem." },
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "bean": {
      "type": "object",
      "required": ["id", "name", "packageId", "kind", "discovery", "materialized", "flow", "constraints", "validations", "expressions", "binds", "properties", "executables", "rules"],
      "properties": {
        "id": { "type": "string", "description": "The class name; kept with include-sources=false." },
        "name": { "type": "string" },
        "packageId": { "type": "string" },
        "kind": { "enum": ["class", "record", "interface", "abstract-class"] },
        "discovery": { "enum": ["scan", "configured", "validated", "cascade"] },
        "source": { "$ref": "#/$defs/source" },
        "groupSequence": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Simple class names; absent unless redefined." },
        "materialized": { "type": "boolean" },
        "flow": { "$ref": "#/$defs/flowRef" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
        "expressions": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        "binds": { "type": "array", "items": { "$ref": "#/$defs/contextBind" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "executables": { "type": "array", "items": { "$ref": "#/$defs/executable" } },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/beanRule" } }
      }
    },
    "flowRef": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["annotation", "name", "attributes", "plain", "groups", "payload", "reportAsSingleViolation", "composing"],
      "properties": {
        "annotation": { "type": "string" },
        "name": { "type": "string", "description": "Simple name with a lower-case initial: the search token." },
        "attributes": { "type": "object" },
        "plain": { "type": "string" },
        "message": { "type": "string" },
        "groups": { "type": "array", "items": { "type": "string" } },
        "severity": { "enum": ["FATAL", "ERROR", "WARNING", "INFO"] },
        "payload": { "type": "array", "items": { "type": "string" } },
        "reportAsSingleViolation": { "type": "boolean" },
        "composing": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "ruleId": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["rules", "groups", "applyTo", "targets"],
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" } },
        "groups": { "type": "array", "items": { "type": "string" } },
        "applyTo": { "type": "string" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/validationTarget" } }
      }
    },
    "validationTarget": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "artifactId": { "type": "string", "description": "Absent when nothing is registered under the name." }
      }
    },
    "expr": {
      "type": "object",
      "required": ["expression", "errorCode", "groups", "applyTo", "skipNull"],
      "properties": {
        "expression": { "$ref": "#/$defs/expression" },
        "errorCode": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "enum": ["FATAL", "ERROR", "WARNING", "INFO"] },
        "groups": { "type": "array", "items": { "type": "string" } },
        "applyTo": { "type": "string" },
        "skipNull": { "type": "boolean" },
        "ruleId": { "type": "string" }
      }
    },
    "contextBind": {
      "type": "object",
      "required": ["name", "type", "kind"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "kind": { "enum": ["literal", "expression"] },
        "literal": { "type": "string" },
        "expression": { "$ref": "#/$defs/expression" },
        "applyTo": { "type": "string" },
        "declaredOn": { "type": "string" }
      }
    },
    "cascade": {
      "type": "object",
      "required": ["targetType", "groupConversions"],
      "properties": {
        "beanId": { "type": "string", "description": "Absent when the target type is not a described bean." },
        "targetType": { "type": "string" },
        "groupConversions": { "type": "array", "items": { "$ref": "#/$defs/groupConversion" } }
      }
    },
    "groupConversion": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "containerElement": {
      "type": "object",
      "required": ["name", "containerType", "typeArgumentIndex", "type", "constraints", "children"],
      "properties": {
        "name": { "type": "string" },
        "containerType": { "type": "string" },
        "typeArgumentIndex": { "type": "integer", "minimum": 0 },
        "type": { "type": "string" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "cascade": { "$ref": "#/$defs/cascade" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/containerElement" } }
      }
    },
    "property": {
      "type": "object",
      "required": ["name", "type", "declaredOn", "constraints", "validations", "expressions", "containerElements"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "genericType": { "type": "string" },
        "declaredOn": { "enum": ["field", "getter", "record-component"] },
        "declaringClass": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
        "expressions": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        "cascade": { "$ref": "#/$defs/cascade" },
        "containerElements": { "type": "array", "items": { "$ref": "#/$defs/containerElement" } }
      }
    },
    "executable": {
      "type": "object",
      "required": ["name", "key", "kind", "signature", "parameters", "binds", "rules"],
      "properties": {
        "name": { "type": "string" },
        "key": { "type": "string" },
        "kind": { "enum": ["method", "constructor", "getter"] },
        "signature": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/beanParameter" } },
        "crossParameter": { "$ref": "#/$defs/crossParameter" },
        "returnValue": { "$ref": "#/$defs/returnValue" },
        "binds": { "type": "array", "items": { "$ref": "#/$defs/contextBind" } },
        "parametersFlow": { "$ref": "#/$defs/flowRef" },
        "returnValueFlow": { "$ref": "#/$defs/flowRef" },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/beanRule" } }
      }
    },
    "beanParameter": {
      "type": "object",
      "required": ["index", "name", "type", "constraints", "validations", "expressions", "containerElements"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "genericType": { "type": "string" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
        "expressions": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        "cascade": { "$ref": "#/$defs/cascade" },
        "containerElements": { "type": "array", "items": { "$ref": "#/$defs/containerElement" } }
      }
    },
    "crossParameter": {
      "type": "object",
      "required": ["constraints", "validations", "expressions"],
      "properties": {
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
        "expressions": { "type": "array", "items": { "$ref": "#/$defs/expr" } }
      }
    },
    "returnValue": {
      "type": "object",
      "required": ["type", "constraints", "validations", "expressions", "containerElements", "binds"],
      "properties": {
        "type": { "type": "string" },
        "genericType": { "type": "string" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
        "expressions": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        "cascade": { "$ref": "#/$defs/cascade" },
        "containerElements": { "type": "array", "items": { "$ref": "#/$defs/containerElement" } },
        "binds": { "type": "array", "items": { "$ref": "#/$defs/contextBind" } }
      }
    },
    "beanRule": {
      "type": "object",
      "required": ["id", "name", "placement", "kind", "parameters", "hosted"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "placement": { "$ref": "#/$defs/placement" },
        "kind": { "enum": ["xml-script", "xml", "rule-class", "java-builder", "predefined-validator", "unknown"] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "rule": { "$ref": "#/$defs/ruleDetails" },
        "validation": { "$ref": "#/$defs/validationDetails" },
        "hosted": { "type": "array", "items": { "$ref": "#/$defs/beanRule" } }
      }
    },
    "placement": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["property", "parameter", "return-value", "cross-parameter", "bean"] },
        "name": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

