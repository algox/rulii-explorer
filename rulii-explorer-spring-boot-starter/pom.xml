<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.rulii</groupId>
        <artifactId>rulii-explorer-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rulii-explorer-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>rulii-explorer-spring-boot-starter</name>
    <description>Spring Boot auto-configuration for the explorer: the /actuator/rulii endpoint and the UI. The one dependency an application adds.</description>

    <dependencies>
        <dependency>
            <groupId>org.rulii</groupId>
            <artifactId>rulii-explorer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.rulii</groupId>
            <artifactId>rulii-explorer-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.rulii</groupId>
            <artifactId>rulii-spring</artifactId>
        </dependency>

        <!-- Brought in for the application: the descriptor is an Actuator endpoint. No web stack;
             the application supplies MVC or WebFlux. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The Boot test matrix: MVC and WebFlux stacks, security, context path, management port -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
